# Where the browser reaches PocketBase. Locally this is the instance started by
# `npm run pb`; in production the platform points it at this project's own
# subdomain. Port 8092 is used locally because other projects on this machine
# already run PocketBase on 8090 and 8091.
NEXT_PUBLIC_POCKETBASE_URL="http://127.0.0.1:8092"

# Permanent public origin encoded on cards. Finalize before writing any card.
NEXT_PUBLIC_CARD_BASE_URL="https://cards.example.com"

# Public hostname served by Caddy, without https://
DOMAIN="rewards.example.com"
