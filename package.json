{
  "name": "nfc-currency-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8000",
    "start": "node build/index.js",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "pb": "./pocketbase serve --http=127.0.0.1:8092 --hooksDir=pb_hooks --migrationsDir=pb_migrations",
    "pb:install": "./deploy/install-pocketbase.sh"
  },
  "dependencies": {
    "pocketbase": "^0.27.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "22.16.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "^6.2.0",
    "vitest": "3.2.7"
  }
}
