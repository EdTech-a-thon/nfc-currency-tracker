# PocketBase runs the pinned release and reads pb_migrations/ and pb_hooks/
# straight out of the repository, so schema changes ship with the code.
FROM alpine:3.20
ARG POCKETBASE_VERSION=0.39.10
RUN apk add --no-cache ca-certificates unzip curl wget
WORKDIR /pb
RUN curl --fail --location --silent --show-error \
      "https://github.com/pocketbase/pocketbase/releases/download/v${POCKETBASE_VERSION}/pocketbase_${POCKETBASE_VERSION}_linux_amd64.zip" \
      -o pocketbase.zip \
 && unzip -q pocketbase.zip pocketbase \
 && rm pocketbase.zip \
 && chmod +x pocketbase
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1:8090/api/health || exit 1
CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data", "--hooksDir=/pb/pb_hooks", "--migrationsDir=/pb/pb_migrations"]
