{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# The browser talks to PocketBase directly, so it needs its own public name.
{$POCKETBASE_DOMAIN} {
	encode zstd gzip
	reverse_proxy pocketbase:8090
	header {
		X-Content-Type-Options nosniff
		-Server
	}
}
